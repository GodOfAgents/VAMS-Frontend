{
  "name": "frontend-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:simulation": "vite --mode simulation",
    "build": "vite build",
    "build:marketing": "vite build --mode marketing",
    "build:console": "vite build --mode console",
    "build:status": "vite build --mode status",
    "build:simulation": "vite build --mode simulation",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:marketing": "vite preview --outDir dist/marketing --host 127.0.0.1 --port 4373 --strictPort",
    "preview:console": "vite preview --outDir dist/console --host 127.0.0.1 --port 4374 --strictPort",
    "preview:status": "vite preview --outDir dist/status --host 127.0.0.1 --port 4375 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "verify": "npm run lint && npm run test && npm run build:marketing && npm run build:console && npm run build:status && npm run test:browser"
  },
  "dependencies": {
    "autoprefixer": "^10.4.23",
    "gsap": "^3.15.0",
    "lucide-react": "^0.563.0",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.1",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "vite": "^7.2.4",
    "vitest": "^3.2.7"
  }
}
