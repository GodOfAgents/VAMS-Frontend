# HTTPS origin only outside local development. Do not include credentials,
# paths, queries, or fragments.
VITE_VAMS_GATEWAY_ORIGIN=http://127.0.0.1:8000
VITE_VAMS_ENVIRONMENT=LOCAL
VITE_VAMS_SURFACE=all

# Fail-closed by default. Enabling this displays a persistent SIMULATED banner
# and uses deterministic synthetic explorer records.
VITE_VAMS_SIMULATION_ENABLED=false
